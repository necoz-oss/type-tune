{
  "name": "type-tune",
  "version": "1.0.2",
  "description": "Rust CLI for finding shared TypeScript types and moving them safely.",
  "keywords": [
    "cli",
    "codemod",
    "refactoring",
    "rust",
    "types",
    "typescript"
  ],
  "homepage": "https://github.com/necoz-oss/type-tune#readme",
  "bugs": {
    "url": "https://github.com/necoz-oss/type-tune/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/necoz-oss/type-tune.git"
  },
  "bin": {
    "type-tune": "./bin/type-tune.mjs"
  },
  "files": [
    "bin"
  ],
  "type": "module",
  "scripts": {
    "build": "mise exec rust@stable -- cargo build --release --workspace",
    "test": "mise exec rust@stable -- cargo test --workspace",
    "test:vue-tsc": "mise exec rust@stable -- cargo test --test vue_tsc_apply -- --ignored --nocapture",
    "verify:movement": "pnpm build && node scripts/verify-movement-fixture.mjs",
    "check": "mise exec rust@stable -- cargo fmt --check && mise exec rust@stable -- cargo clippy --workspace -- -D warnings && pnpm test && pnpm build && pnpm compatibility:check",
    "compatibility:check": "node scripts/compatibility-fixtures.mjs",
    "native:version:check": "node scripts/sync-native-versions.mjs --check",
    "docs:dev": "pnpm --filter ./docs dev",
    "docs:build": "pnpm --filter ./docs build",
    "docs:check": "pnpm --filter ./docs check",
    "docs:preview": "pnpm --filter ./docs preview",
    "package:check": "node scripts/check-package.mjs",
    "publish:check": "pnpm check && pnpm native:version:check && pnpm package:check",
    "release:check": "pnpm check && pnpm package:check",
    "prepublishOnly": "pnpm publish:check"
  },
  "devDependencies": {
    "lefthook": "^2.1.8",
    "typescript": "6.0.3",
    "vue": "3.5.45",
    "vue-tsc": "3.3.14"
  },
  "optionalDependencies": {
    "@type-tune/darwin-arm64": "1.0.2",
    "@type-tune/darwin-x64": "1.0.2",
    "@type-tune/linux-x64-gnu": "1.0.2",
    "@type-tune/linux-x64-musl": "1.0.2",
    "@type-tune/win32-x64-msvc": "1.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.2.2"
}
